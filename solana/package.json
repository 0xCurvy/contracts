{
  "name": "solana-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:surfpool": "anchor test --skip-local-validator --skip-deploy",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "derive-portal": "npx tsx scripts/derive-portal.ts",
    "generate-portal-data": "npx tsx scripts/generate-portal-data.ts",
    "devnet:derive": "npx tsx scripts/derive-portal-devnet.ts",
    "mainnet:derive": "npx tsx scripts/derive-portal-mainnet.ts",
    "devnet:fund": "npx tsx scripts/fund-portal-devnet.ts",
    "devnet:bridge": "npx tsx scripts/bridge-portal-devnet.ts",
    "devnet:recover": "npx tsx scripts/recover-portal-devnet.ts",
    "quote-bridge": "npx tsx scripts/quote-bridge.ts",
    "execute-bridge": "npx tsx scripts/execute-bridge.ts",
    "init:devnet": "ANCHOR_PROVIDER_URL=https://api.devnet.solana.com ANCHOR_WALLET=~/.config/solana/id.json npx tsx migrations/deploy.ts",
    "init:mainnet": "ANCHOR_PROVIDER_URL=https://api.mainnet-beta.solana.com ANCHOR_WALLET=~/.config/solana/id.json npx tsx migrations/deploy.ts"
  },
  "dependencies": {
    "@0xcurvy/curvy-sdk": "workspace:*",
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/curves": "^2.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@lifi/sdk": "^3.13.6",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "bs58": "^6.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
