# Test fixture keypairs used by the local mocha suite (devnet-helpers / recovery tests).
# Each value is the JSON byte array produced by `solana-keygen new --no-bip39-passphrase`.
# Generate with: `solana-keygen new --outfile /tmp/u1.json && cat /tmp/u1.json`
#
# These are TEST keys only — never reuse them on mainnet. The real .env file is
# git-ignored; copy this template to .env and fill it in locally.
USER1_SECRET_KEY=[1,2,3,...]
USER2_SECRET_KEY=[1,2,3,...]
USER3_SECRET_KEY=[1,2,3,...]
USER4_SECRET_KEY=[1,2,3,...]
