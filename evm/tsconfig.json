{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "preserve",
    "target": "ES2021",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "outDir": "dist",
    "allowJs": true
  },
  "ts-node": {
    "esm": true,
    "experimentalResolver": true
  }
}
